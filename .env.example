# Puerto local o del hosting
PORT=8080

# Folio inicial. Si el último emitido fue SANTM 2-981, deja 981.
FOLIO_PREFIX=SANTM 2-
LAST_FOLIO_NUMBER=981

# Solo estos números podrán emitir. Usa formato con país, sin espacios. Separar por comas.
# Ejemplo México: 526621989843,526621234567
ALLOWED_NUMBERS=526621989843

# URL pública de tu app desplegada. En Render/Railway/Replit debe ser https.
# Si lo dejas vacío, se toma del request entrante.
PUBLIC_BASE_URL=

# Token simple para que los PDFs no queden en una ruta fácil de adivinar.
# Cambia este valor por uno largo y privado.
MEDIA_ROUTE_TOKEN=cambia_este_token_largo
